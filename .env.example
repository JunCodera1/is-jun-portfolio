# Public canonical origin used for canonical URLs, hreflang, sitemap and Open Graph.
# Set this to your real production origin (no trailing slash), e.g. https://example.com
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL, server-only. Raises the GitHub API rate limit for the cached repository feed.
# A fine-grained token with *no* extra permissions (public read-only) is enough.
# Never prefix with NEXT_PUBLIC_ and never commit a real value.
GITHUB_TOKEN=

# ── AI assistant (/ask). OPTIONAL: without these the assistant quotes the site itself. ─────────────
# AI_PROVIDER=anthropic          # "none" (default) or "anthropic"
# ANTHROPIC_API_KEY=             # server-only; never NEXT_PUBLIC_
# AI_MODEL=claude-haiku-5-5
# AI_DAILY_REQUESTS=200          # hard daily cap on model calls
# AI_RATE_PER_MIN=8              # per client
# AI_MAX_OUTPUT_TOKENS=400

# ── Owner console (/owner) and agents. OPTIONAL: if any of the first two is missing, or DATA_DIR is not writable, the console does not exist (404). ─
# Generate both with:  npm run owner:hash
# OWNER_PASSWORD_HASH=scrypt$16384$8$1$...
# SESSION_SECRET=                # at least 32 characters
# DATA_DIR=.data                 # audit log, task history, proposals (gitignored). Back this directory up.

# ── Integrations ───────────────────────────────────────────────────────────────────────────────────
# INTEGRATIONS_DISABLED=news.hn,deezer   # comma-separated ids to switch off
