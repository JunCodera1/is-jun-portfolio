# Public canonical origin used for canonical URLs, hreflang, sitemap and Open Graph.
# Set this to your real production origin (no trailing slash), e.g. https://example.com
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL, server-only. Raises the GitHub API rate limit for the cached repository feed.
# A fine-grained token with *no* extra permissions (public read-only) is enough.
# Never prefix with NEXT_PUBLIC_ and never commit a real value.
GITHUB_TOKEN=
