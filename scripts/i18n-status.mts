/**
 * Translation status report (row 10): UI strings, MDX content and data-file copy, per locale.
 * Writes docs/TRANSLATION_STATUS.md. Run: npm run i18n:status   (exits 1 if a UI key is missing in any locale)
 */
import { readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { getEntry, listIds } from "@/lib/content";
import { locales, type Locale } from "@/i18n/routing";
import { projects } from "@/content/data/projects";
import { profile } from "@/content/data/profile";
import { resolveText, type LocalizedText } from "@/lib/localized";

const root = resolve(import.meta.dirname, "..");
type Tree = { [k: string]: string | Tree };
const flatten = (o: Tree, p = ""): string[] => Object.entries(o).flatMap(([k, v]) => (typeof v === "string" ? [p ? `${p}.${k}` : k] : flatten(v, p ? `${p}.${k}` : k)));
const catalog = (l: Locale) => new Set(flatten(JSON.parse(readFileSync(`${root}/messages/${l}.json`, "utf8")) as Tree));
const en = catalog("en");

let failed = false;
let md = `# Translation status\n\n> Generated by \`npm run i18n:status\`. English is the source language.\n\n`;

md += `## UI strings (\`messages/*.json\`)\n\n| Locale | Keys | Missing vs English | Review state |\n|---|---:|---:|---|\n`;
for (const l of locales) {
  const c = catalog(l);
  const missing = [...en].filter((k) => !c.has(k));
  if (missing.length) failed = true;
  md += `| ${l} | ${c.size} | ${missing.length}${missing.length ? ` (${missing.slice(0, 5).join(", ")}…)` : ""} | ${l === "en" ? "source" : "complete — **needs native review by the owner**"} |\n`;
}

md += `\n## Long-form content (MDX)\n\n| Collection / id | ${locales.join(" | ")} |\n|---|${locales.map(() => "---").join("|")}|\n`;
const tally: Record<string, Record<string, number>> = Object.fromEntries(locales.map((l) => [l, { translated: 0, draft: 0, untranslated: 0 }]));
for (const c of ["garden", "journal"] as const) {
  for (const id of listIds(c)) {
    const cells = locales.map((l) => { const s = getEntry(c, id, l)!.status; tally[l]![s]!++; return s; });
    md += `| ${c}/${id} | ${cells.join(" | ")} |\n`;
  }
}

const texts: LocalizedText[] = [profile.tagline, ...projects.flatMap((p) => [p.summary, ...p.highlights, ...Object.values(p.caseStudy)])];
md += `\n## Data-file copy (projects, tagline)\n\n| Locale | translated | draft | untranslated |\n|---|---:|---:|---:|\n`;
for (const l of locales) {
  const t = { translated: 0, draft: 0, untranslated: 0 };
  for (const x of texts) t[resolveText(x, l).status]++;
  md += `| ${l} | ${t.translated} | ${t.draft} | ${t.untranslated} |\n`;
}
md += `\n"draft" = written for this site but not yet reviewed by a native speaker; it is labelled as such to visitors.\n`;

writeFileSync(`${root}/docs/TRANSLATION_STATUS.md`, md);
console.log(md);
process.exit(failed ? 1 : 0);
