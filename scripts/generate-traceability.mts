/**
 * Generates docs/REQUIREMENTS_TRACEABILITY.md from
 *   docs/requirements/requirements-source.json  (extracted verbatim from the xlsx — never hand-edited)
 *   docs/requirements/requirements-status.json  (the ONLY place statuses are edited)
 * Completion counts and percentages are computed here, never typed. Run: npm run docs:traceability
 *
 * Integrity rules enforced (the script exits 1 on violation):
 *   - every source row has a status entry and vice-versa
 *   - TESTED / VERIFIED  ⇒  `gaps` is empty     (a row with open acceptance parts can stop at IMPLEMENTED at best)
 *   - VERIFIED           ⇒  at least one `evidence` item
 *   - DEFERRED / BLOCKED ⇒  a `reason`
 */
import { readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";

const root = resolve(import.meta.dirname, "..");
type Source = { id: string; excelRow: number; excelGroupId: string; group: string; requirement: string; level: string; priority: string; criteria: string };
type Entry = { status: string; implementation: string; verification?: string; evidence?: string[]; gaps?: string[]; reason?: string; notes?: string };

const source = JSON.parse(readFileSync(`${root}/docs/requirements/requirements-source.json`, "utf8")).rows as Source[];
const status = JSON.parse(readFileSync(`${root}/docs/requirements/requirements-status.json`, "utf8")).requirements as Record<string, Entry>;

const STATUSES = ["NOT_STARTED", "IN_PROGRESS", "IMPLEMENTED", "TESTED", "VERIFIED", "DEFERRED", "BLOCKED"] as const;
const errors: string[] = [];
for (const s of source) if (!status[s.id]) errors.push(`missing status for ${s.id}`);
for (const id of Object.keys(status)) if (!source.some((s) => s.id === id)) errors.push(`status for unknown requirement ${id}`);
for (const [id, e] of Object.entries(status)) {
  if (!STATUSES.includes(e.status as (typeof STATUSES)[number])) errors.push(`${id}: invalid status ${e.status}`);
  if ((e.status === "TESTED" || e.status === "VERIFIED") && (e.gaps?.length ?? 0) > 0) errors.push(`${id}: ${e.status} but has open gaps`);
  if (e.status === "VERIFIED" && !(e.evidence?.length)) errors.push(`${id}: VERIFIED without evidence`);
  if ((e.status === "DEFERRED" || e.status === "BLOCKED") && !e.reason) errors.push(`${id}: ${e.status} without reason`);
}
if (errors.length) { console.error(errors.join("\n")); process.exit(1); }

const esc = (s: string) => s.replace(/\|/g, "\\|").replace(/\n/g, " ");
const counts = Object.fromEntries(STATUSES.map((s) => [s, 0])) as Record<string, number>;
for (const s of source) counts[status[s.id]!.status]!++;
const total = source.length;
const pct = (n: number) => `${((n / total) * 100).toFixed(1)}%`;
const atLeast = (list: string[]) => list.reduce((n, s) => n + counts[s]!, 0);

const byPriority = (p: string) => {
  const rows = source.filter((s) => s.priority === p);
  const c = (...st: string[]) => rows.filter((r) => st.includes(status[r.id]!.status)).length;
  return `| ${p} | ${rows.length} | ${c("VERIFIED")} | ${c("TESTED")} | ${c("IMPLEMENTED")} | ${c("IN_PROGRESS")} | ${c("DEFERRED")} | ${c("BLOCKED")} |`;
};

let md = `# Requirements Traceability

> **Generated** by \`npm run docs:traceability\` from \`docs/requirements/requirements-source.json\` (verbatim from \`my_digital_space_requirements.xlsx\`, sheet *Requirements*, ${total} rows) and \`docs/requirements/requirements-status.json\`.
> Do not edit this file — edit the status JSON and regenerate.

## How to read this

* **IDs.** The spreadsheet's IDs are per *group* (01–11), not per row, so stable IDs \`REQ-<group>-<n>\` were generated; the original Excel row number is kept in the first column.
* **Priorities.** Spreadsheet level → tier: *Bắt buộc* → **P0**, *Nên có* → **P1**, *Tùy chọn* → **P2**, *Thử nghiệm* → **P3**. Stack rows marked *Đề xuất chính* are treated as **P0** (foundation) and *Đề xuất* as **P1**. Rows 62–65 (*Cần chủ website cung cấp*) are **OWNER** inputs. The spreadsheet wins over the master prompt where they differ (e.g. the prompt lists the library and GitHub integration at P1; the sheet marks them optional).
* **Statuses.** \`IMPLEMENTED\` code exists · \`TESTED\` relevant automated tests ran and passed · \`VERIFIED\` acceptance criteria checked with evidence · \`DEFERRED\` postponed on purpose, with a reason · \`BLOCKED\` waiting on something outside the code.
* **Compound rows.** Many rows bundle several acceptance criteria. A row can only be TESTED/VERIFIED when **no part is open** (the generator enforces this); open parts are listed under *Open parts* and keep the row at IMPLEMENTED.

## Completion summary (computed)

| Status | Count | Share of ${total} |
|---|---:|---:|
${STATUSES.map((s) => `| ${s} | ${counts[s]} | ${pct(counts[s]!)} |`).join("\n")}
| **Total** | **${total}** | 100% |

* **Done and checked (TESTED + VERIFIED): ${atLeast(["TESTED", "VERIFIED"])} / ${total} = ${pct(atLeast(["TESTED", "VERIFIED"]))}**
* Built but not fully closed (IMPLEMENTED + IN_PROGRESS): ${atLeast(["IMPLEMENTED", "IN_PROGRESS"])} = ${pct(atLeast(["IMPLEMENTED", "IN_PROGRESS"]))}
* Not built (DEFERRED + BLOCKED + NOT_STARTED): ${atLeast(["DEFERRED", "BLOCKED", "NOT_STARTED"])} = ${pct(atLeast(["DEFERRED", "BLOCKED", "NOT_STARTED"]))}

By priority:

| Priority | Rows | VERIFIED | TESTED | IMPLEMENTED | IN_PROGRESS | DEFERRED | BLOCKED |
|---|---:|---:|---:|---:|---:|---:|---:|
${["P0", "P1", "P2", "P3", "OWNER"].map(byPriority).join("\n")}

## Requirements

| ID | Excel row | Category | Requirement | Prio | Status | Implementation | Verification / evidence | Open parts, reasons, notes |
|---|---:|---|---|---|---|---|---|---|
`;
for (const s of source) {
  const e = status[s.id]!;
  const ver = [e.verification, ...(e.evidence ?? [])].filter(Boolean).join("; ");
  const open = [e.gaps?.length ? `**Open:** ${e.gaps.join("; ")}` : "", e.reason ? `**Reason:** ${e.reason}` : "", e.notes ?? ""].filter(Boolean).join(" — ");
  md += `| ${s.id} | ${s.excelRow} | ${esc(s.group)} | ${esc(s.requirement)} | ${s.priority} | \`${e.status}\` | ${esc(e.implementation)} | ${esc(ver || "—")} | ${esc(open || "—")} |\n`;
}

md += `
## Original acceptance criteria (verbatim from the spreadsheet)

| ID | Criteria / notes (Vietnamese, as written) |
|---|---|
${source.map((s) => `| ${s.id} | ${esc(s.criteria)} |`).join("\n")}
`;

writeFileSync(`${root}/docs/REQUIREMENTS_TRACEABILITY.md`, md);
console.log(`traceability: ${total} rows — ${STATUSES.map((s) => `${s}=${counts[s]}`).join(" ")} — done+checked ${pct(atLeast(["TESTED", "VERIFIED"]))}`);
