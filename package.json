{
  "name": "my-digital-space",
  "version": "0.1.0",
  "private": true,
  "description": "A multilingual (en/ja/vi) personal digital space: identity, notes, projects and craft.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "i18n:status": "tsx --conditions=react-server scripts/i18n-status.mts",
    "docs:traceability": "tsx scripts/generate-traceability.mts",
    "content:check": "tsx --conditions=react-server scripts/check-content.mts",
    "snapshot:github": "tsx scripts/snapshot-github.mts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run content:check && npm run i18n:status"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
